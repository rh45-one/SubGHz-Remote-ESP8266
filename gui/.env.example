# Real device configuration (leave URL empty for fail-closed disconnected operation).
DEVICE_MODE=real
ESP_BASE_URL=
# Add the exact Tailscale Serve hostname when deploying; no wildcard.
ALLOWED_HOSTS=localhost,127.0.0.1
# Offline demonstration: DEVICE_MODE=simulated. Never points at hardware.
# Container image & tag selection (track moving 'latest' for auto-updates, or pin e.g. 'ui-v0.1.0' for rollback).
GUI_IMAGE=ghcr.io/rh45-one/subghz-remote-esp8266-gui
GUI_IMAGE_TAG=latest
GUI_PULL_POLICY=missing
# Opt-in labels for an external Watchtower instance launched with --label-enable (and optional --scope).
WATCHTOWER_ENABLE=true
WATCHTOWER_SCOPE=subghz-remote
